# Phantom Swarm Engine — environment config
# Copy to .env and fill in. .env is gitignored; never commit real keys.

# ---------------------------------------------------------------------------
# LLM backend (pick ONE provider — both are OpenAI-compatible)
# ---------------------------------------------------------------------------
LLM_PROVIDER=openrouter                 # "openrouter" or "deepseek"

# OpenRouter
OPENROUTER_API_KEY=                     # sk-or-...
# OPENROUTER_PREMIUM_MODEL=anthropic/claude-sonnet-4-6
# OPENROUTER_FLEET_MODEL=meta-llama/llama-3.3-70b-instruct
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1   # override for a local/self-hosted endpoint

# DeepSeek (cheaper alternative)
DEEPSEEK_API_KEY=                       # sk-...
# DEEPSEEK_PREMIUM_MODEL=deepseek-reasoner
# DEEPSEEK_FLEET_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com         # override for a local/self-hosted endpoint

# ---------------------------------------------------------------------------
# Auth for protected write endpoints (optional but recommended)
# ---------------------------------------------------------------------------
PHANTOM_INTERNAL_SECRET=                # any strong random string

# ---------------------------------------------------------------------------
# Bundle storage (optional)
# ---------------------------------------------------------------------------
# BUNDLE_STORE_DIR=bundle_store
# REDIS_URL=redis://localhost:6379/0   # durable, multi-replica storage; falls back to disk if unset/unreachable

# ---------------------------------------------------------------------------
# Logging / observability (optional)
# ---------------------------------------------------------------------------
# LOG_LEVEL=INFO                        # DEBUG, INFO, WARNING, ERROR
# LOG_JSON=1                            # structured JSON logs (recommended in prod)

# ---------------------------------------------------------------------------
# Rate limiting (optional; slowapi syntax "<count>/<period>")
# ---------------------------------------------------------------------------
# RATE_LIMIT_BUNDLE_CREATE=10/minute
# RATE_LIMIT_SWARM_START=10/minute
# RATE_LIMIT_DEFAULT=120/minute

# ---------------------------------------------------------------------------
# Limits & cost model (optional)
# ---------------------------------------------------------------------------
# MAX_SPEC_LENGTH=8000
# BUNDLER_MAX_CONCURRENCY=6             # cap on parallel critique calls
# COST_PREMIUM_PER_MTOK=3.0            # USD / 1M tokens (for /bundle/estimate)
# COST_FLEET_PER_MTOK=0.20

# ---------------------------------------------------------------------------
# CORS (optional) — comma-separated origins, or "*" for any (dev only)
# ---------------------------------------------------------------------------
# CORS_ORIGINS=https://yourapp.com,http://localhost:3000

# ---------------------------------------------------------------------------
# Crypto paywall (OPTIONAL, OFF by default). Set both to enable.
# Charges people to use YOUR hosted instance; funds go to your wallet.
# ---------------------------------------------------------------------------
# CRYPTO_PAYMENTS_ENABLED=1
# CRYPTO_PAY_TO=                        # your Solana receiving wallet
# CRYPTO_ACCEPT=SOL:0.5,USDC:75         # accept either; per-asset price
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# CRYPTO_COMMITMENT=confirmed           # "confirmed" (default) or "finalized"

# ---------------------------------------------------------------------------
# Legacy swarm extras (optional)
# ---------------------------------------------------------------------------
# SEGMIND_API_KEY=                      # art generation
# TWITTER_API_KEY=
# TWITTER_API_SECRET=
# TWITTER_ACCESS_TOKEN=
# TWITTER_ACCESS_TOKEN_SECRET=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
