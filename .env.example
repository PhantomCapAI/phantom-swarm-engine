# Phantom Swarm Engine — environment config
# Copy to .env and fill in. .env is gitignored; never commit real keys.

# ---------------------------------------------------------------------------
# LLM backend (pick ONE provider — both are OpenAI-compatible)
# ---------------------------------------------------------------------------
LLM_PROVIDER=openrouter                 # "openrouter" or "deepseek"

# OpenRouter
OPENROUTER_API_KEY=                     # sk-or-...
# OPENROUTER_PREMIUM_MODEL=anthropic/claude-sonnet-4-6
# OPENROUTER_FLEET_MODEL=meta-llama/llama-3.3-70b-instruct
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1   # override for a local/self-hosted endpoint

# DeepSeek (cheaper alternative)
DEEPSEEK_API_KEY=                       # sk-...
# DEEPSEEK_PREMIUM_MODEL=deepseek-reasoner
# DEEPSEEK_FLEET_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com         # override for a local/self-hosted endpoint

# ---------------------------------------------------------------------------
# Auth for protected write endpoints (optional but recommended)
# ---------------------------------------------------------------------------
PHANTOM_INTERNAL_SECRET=                # any strong random string

# ---------------------------------------------------------------------------
# Bundle storage (optional)
# ---------------------------------------------------------------------------
# BUNDLE_STORE_DIR=bundle_store

# ---------------------------------------------------------------------------
# Resource limits (optional — sensible defaults shown)
# ---------------------------------------------------------------------------
# MAX_CONCURRENT_BUNDLES=4        # concurrent bundle jobs; excess are queued
# SESSION_TTL_SECONDS=3600        # evict finished in-memory sessions after this
# MAX_SESSIONS=500                # hard cap on retained sessions
# MAX_SPEC_CHARS=20000            # reject specs larger than this
# RATE_LIMIT_PER_MIN=60           # per-IP /bundle/create limit (0 = off)

# ---------------------------------------------------------------------------
# Crypto paywall (OPTIONAL, OFF by default). Set both to enable.
# Charges people to use YOUR hosted instance; funds go to your wallet.
# ---------------------------------------------------------------------------
# CRYPTO_PAYMENTS_ENABLED=1
# CRYPTO_PAY_TO=                        # your Solana receiving wallet
# CRYPTO_ACCEPT=SOL:0.5,USDC:75         # accept either; per-asset price
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ---------------------------------------------------------------------------
# Legacy swarm extras (optional)
# ---------------------------------------------------------------------------
# SEGMIND_API_KEY=                      # art generation
# TWITTER_API_KEY=
# TWITTER_API_SECRET=
# TWITTER_ACCESS_TOKEN=
# TWITTER_ACCESS_TOKEN_SECRET=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
